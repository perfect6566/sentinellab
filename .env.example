# Flask runtime
FLASK_ENV=development
SECRET_KEY=replace-with-a-random-server-secret
REQUIRE_LIVE_LLM=false
MAX_UPLOAD_MB=10
MAX_CSV_ROWS=10000
SESSION_FILE_TTL_SECONDS=3600

# Production artifact
MODEL_ARTIFACT_PATH=artifacts/production-model.joblib

# Local development: codex_cli reuses the authenticated local Codex CLI without an API key.
# Hosted/DeepSeek: use deepseek (recommended) or openai_compatible with server-side credentials.
# deepseek defaults to LLM_API_BASE=https://api.deepseek.com/v1 and LLM_MODEL=deepseek-chat
# when left empty; only LLM_API_KEY is required.
LLM_PROVIDER=mock
LLM_MODEL=
LLM_API_BASE=
LLM_API_KEY=

# Agent limits
AGENT_MAX_TURNS=8
AGENT_MAX_TOOL_CALLS=6
AGENT_TIMEOUT_SECONDS=60
